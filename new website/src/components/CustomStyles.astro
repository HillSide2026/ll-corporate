<style is:inline>
  :root {
    --ll-color-brand-navy: #1d4771;
    --ll-color-brand-navy-dark: #0d3d7c;
    --ll-color-brand-blue: #0365b2;
    --ll-color-brand-red: #ff5e5b;
    --ll-color-ink: #2e2e2e;
    --ll-color-border-subtle: #d1d5db;
    --ll-color-stone-50: #fafaf9;
    --ll-color-stone-100: #f5f5f4;
    --ll-color-stone-200: #e7e5e4;
    --ll-color-stone-400: #a8a29e;
    --ll-color-stone-500: #78716c;
    --ll-color-stone-600: #57534e;

    --aw-font-sans: system-ui;
    --aw-font-serif: Georgia;
    --aw-font-heading: system-ui;

    --aw-color-primary: var(--ll-color-brand-navy);
    --aw-color-secondary: var(--ll-color-brand-navy-dark);
    --aw-color-accent: var(--ll-color-brand-blue);

    --aw-color-text-heading: var(--ll-color-ink);
    --aw-color-text-default: var(--ll-color-ink);
    --aw-color-text-page: var(--ll-color-ink);
    --aw-color-text-muted: var(--ll-color-stone-600);
    --aw-color-bg-page: #ffffff;

    --aw-color-bg-page-dark: var(--ll-color-stone-50);

    ::selection {
      background-color: color-mix(in srgb, var(--ll-color-brand-navy) 18%, transparent);
    }
  }

  .dark {
    --aw-font-sans: system-ui;
    --aw-font-serif: Georgia;
    --aw-font-heading: system-ui;

    --aw-color-primary: var(--ll-color-brand-navy);
    --aw-color-secondary: var(--ll-color-brand-navy-dark);
    --aw-color-accent: var(--ll-color-brand-blue);

    --aw-color-text-heading: var(--ll-color-ink);
    --aw-color-text-default: var(--ll-color-ink);
    --aw-color-text-page: var(--ll-color-ink);
    --aw-color-text-muted: var(--ll-color-stone-600);
    --aw-color-bg-page: #ffffff;
    --aw-color-bg-page-dark: var(--ll-color-stone-50);

    ::selection {
      background-color: color-mix(in srgb, var(--ll-color-brand-navy) 18%, transparent);
      color: var(--ll-color-ink);
    }
  }
</style>
