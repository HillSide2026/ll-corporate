# Optional until backend contract integration begins.
LL_TASK_TRACKER_API_BASE_URL=

# Public app origin and current application routes.
LL_CORPORATE_APP_BASE_URL=https://clients.levine-law.ca/sign-in
LL_CORPORATE_POST_LOGIN_REDIRECT_URL=https://clients.levine-law.ca/corporate/app
LL_CORPORATE_LOGOUT_REDIRECT_URL=https://clients.levine-law.ca/sign-in

# Auth.js session and reverse proxy configuration.
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=https://clients.levine-law.ca/corporate/api/auth

# Keycloak/OIDC identity configuration.
AUTH_KEYCLOAK_ISSUER=https://keycloak.example.com/realms/levine-law
AUTH_KEYCLOAK_ID=ll-corporate
AUTH_KEYCLOAK_SECRET=

# Durable portal access request review API.
# Required for Stage 2 admin review at /corporate/admin/access-requests.
PORTAL_ACCESS_REQUEST_API_BASE_URL=
PORTAL_ACCESS_REQUEST_API_TOKEN=

# Transitional approved capture endpoint.
# Used only when the API above is not configured. When unset, the homepage form
# must not claim successful submission.
PORTAL_ACCESS_REQUEST_WEBHOOK_URL=
PORTAL_ACCESS_REQUEST_WEBHOOK_SECRET=

# Optional notification webhook for request confirmations and firm alerts.
# Persistence must happen before this webhook is called.
PORTAL_NOTIFICATION_WEBHOOK_URL=
PORTAL_NOTIFICATION_WEBHOOK_TOKEN=

# Stage 3 durable portal storage.
# Apply docs/portal-stage3-schema.sql to the configured Postgres database.
# PORTAL_DATABASE_URL may be used for a dedicated portal DB; POSTGRES_URL is
# also accepted for Vercel Postgres-style projects.
PORTAL_DATABASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Private Vercel Blob token for durable document uploads/downloads.
BLOB_READ_WRITE_TOKEN=

# Explicit dev/preview-only fallback to mock matter/document/request data when
# durable services are not configured. Keep false/unset for production launch.
PORTAL_ENABLE_MOCK_FALLBACK=false
